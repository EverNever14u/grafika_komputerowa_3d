#X3D V3.3 utf8
DEF Pierwszy Transform { 
    translation 0 0 0
    rotation 0 0 0 0
    children [ 
        Shape { 
            appearance Appearance { 
                material Material { 
                    diffuseColor 0 0 1 
                } 
            } 
            geometry Box {} 
        } 
    ] 
} 


DEF Drugi Transform { 
    translation 5 0 0 
    children [ 
        Shape { 
            appearance Appearance { 
                material Material { 
                    diffuseColor 1 1 0 
                } 
            } 
            geometry Sphere {} 
        } 
    ] 
}


DEF Czas TimeSensor { 
    loop TRUE
    cycleInterval 10
}

DEF EarthTime TimeSensor {
    loop TRUE
    cycleInterval 2
}

DEF Inter PositionInterpolator {
    key [ 0, 0.25, 0.5, 0.75, 1 ] 
    keyValue [ 5 0 0, 0 5 0, -5 0 0, 0 -5 0, 5 0 0 ] 
}

DEF EarthRotationIter OrientationInterpolator {
    key [0,  1]
    keyValue [0 0 1 0, 0 0 1 3.14]
    
} 

ROUTE Czas.fraction_changed TO Inter.set_fraction

ROUTE Inter.value_changed TO Drugi.set_translation

ROUTE EarthTime.fraction_changed TO EarthRotationIter.set_fraction
ROUTE EarthRotationIter.value_changed TO Pierwszy.set_rotation
