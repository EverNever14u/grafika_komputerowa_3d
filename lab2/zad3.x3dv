#X3D V3.3 utf8

#Sun

DEF Sun Transform { 
    translation 0 0 0
    rotation 0 0 0 0
    children [ 
        Shape { 
            appearance Appearance { 
                material Material { 
                    diffuseColor 1 1 1
                }
                texture ImageTexture { 
                    url "sun.jpg" 
                }  
            } 
            geometry Sphere {
                radius 9
            } 
        } 
    ] 
} 

DEF SunTime TimeSensor {
    loop TRUE
    cycleInterval 3.125
}

DEF SunRotationIter OrientationInterpolator {
    key [0,0.5, 1]
    keyValue [0 0 1 0,0 0 1 3.14, 0 0 1 6.28]
    
} 

ROUTE SunTime.fraction_changed TO SunRotationIter.set_fraction
ROUTE SunRotationIter.value_changed TO Sun.set_rotation


#earth
DEF EarthOuter Transform { 
    translation 30 0 0 
    center -30 0 0
    rotation 0 0 0 0


    children [ 

        DEF EarthInner Transform {
        rotation 0 0 0 0

        children [Shape { 
            appearance Appearance { 
                material Material { 
                    diffuseColor 1 1 1 
                } 
     
                texture ImageTexture { 
                    url "2k_earth_daymap.jpg" 
                } 
            
            } 
            geometry Sphere {
                radius 3
            } 
        } ]
        }
 
        
    ] 
}


DEF EarthOuterTime TimeSensor { 
    loop TRUE
    cycleInterval 46
}

DEF EarthOuterIter OrientationInterpolator {
    key [0,0.5, 1]
    keyValue [0 0 1 0,0 0 1 3.14, 0 0 1 6.28]
}

ROUTE EarthOuterTime.fraction_changed TO EarthOuterIter.set_fraction
ROUTE EarthOuterIter.value_changed TO EarthOuter.set_rotation


DEF EarthInnerTime TimeSensor { 
    loop TRUE
    cycleInterval 0.125
}

DEF EarthInnerIter OrientationInterpolator {
    key [0,0.5, 1]
    keyValue [0 0 1 0,0 0 1 3.14, 0 0 1 6.28]
}
ROUTE EarthInnerTime.fraction_changed TO EarthInnerIter.set_fraction

ROUTE EarthInnerIter.value_changed TO EarthInner.set_rotation




