#X3D V3.3 utf8



Transform {
    children Shape {
        geometry Box { size 50 50 1 }
        appearance Appearance {
            material Material {
                emissiveColor 0.08 0.2 0.1
                diffuseColor 0.1 0.25 0.12
            }
        }
    }
}


Transform {
    children [
        Switch {
            whichChoice -1
            children [
                DEF Wall Shape {
                    appearance Appearance { 
                        material Material { 
                            emissiveColor 0.8 0.2 0.2 
                            specularColor 0 0.1 0 
                            diffuseColor 0.1 0.1 0.1
                        } 
                    } 
                    geometry Box {
                        size 2 2 2
                    }
                }
            ]
        }
    ]
}


DEF Door Transform {
    translation 18 20 2
    children Shape {
        geometry Box { size 3.2 0.8 3 }
        appearance Appearance {
            material Material {
                emissiveColor 0.1 0.1 0.2
                diffuseColor 0.1 0.1 0.25
            }

        }
    }
}

#otwarcie drzwi

DEF DoorTime TimeSensor {
    loop FALSE
    cycleInterval 2
}

DEF DoorIter PositionInterpolator{
    key [0, 1]
    keyValue [18 20 2, 18 20 -0.99]
}

DEF StartSensor ProximitySensor {
    center 0 0 0
    size 1000 1000 1000
}

ROUTE StartSensor.enterTime TO DoorTime.set_startTime
ROUTE DoorTime.fraction_changed TO DoorIter.set_fraction
ROUTE DoorIter.value_changed TO Door.set_translation

